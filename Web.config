<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<!--
    ============================================================
    Config Sections
    ============================================================
  -->
	<configSections>
		<!-- Entity Framework configuration section -->
		<section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
	</configSections>

	<!--
    ============================================================
    Connection Strings
    ============================================================
    Ensure the name matches the one used in your code:
    ConfigurationManager.ConnectionStrings["RangerQuestDB"]
  -->
	<connectionStrings>
		<add name="RangerQuestDB"
			 connectionString="Server=localhost;Port=3306;Database=rangerquestdb;Uid=root;Pwd=Dagg@12;"
			 providerName="MySql.Data.MySqlClient" />
	</connectionStrings>

	<!--
    ============================================================
    System.Web Settings
    ============================================================
  -->
	<system.web>
		<!-- Compilation and target framework -->
		<compilation debug="true" targetFramework="4.8.1" />
		<httpRuntime targetFramework="4.8.1" />

		<!-- Forms Authentication – protects all pages except those explicitly allowed -->
		<authentication mode="Forms">
			<forms loginUrl="~/Login.aspx" timeout="2880" slidingExpiration="true" />
		</authentication>

		<!-- Global authorization: deny unauthenticated users -->
		<authorization>
			<deny users="?" />
		</authorization>

		<!-- 
      Optional: Set custom error mode for production 
      <customErrors mode="RemoteOnly" defaultRedirect="~/Error.aspx" />
    -->

		<!-- Session state (optional, adjust as needed) -->
		<sessionState mode="InProc" timeout="30" />

		<!-- Machine key (for production, generate a unique key) 
         <machineKey validationKey="..." decryptionKey="..." />
    -->
	</system.web>

	<!--
    ============================================================
    Allow Anonymous Access to Login and Register Pages
    ============================================================
  -->
	<location path="Login.aspx">
		<system.web>
			<authorization>
				<allow users="*" />
			</authorization>
		</system.web>
	</location>

	<location path="Register.aspx">
		<system.web>
			<authorization>
				<allow users="*" />
			</authorization>
		</system.web>
	</location>

	<!--
    ============================================================
    Runtime Assembly Binding Redirects
    ============================================================
    Resolves version conflicts between referenced NuGet packages.
  -->
	<runtime>
		<assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
			<!-- MySQL Connector -->
			<dependentAssembly>
				<assemblyIdentity name="MySql.Data" publicKeyToken="c5687fc88969c44d" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-9.7.0.0" newVersion="9.7.0.0" />
			</dependentAssembly>

			<!-- Newtonsoft.Json -->
			<dependentAssembly>
				<assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-13.0.0.0" newVersion="13.0.0.0" />
			</dependentAssembly>

			<!-- Microsoft.Web.Infrastructure -->
			<dependentAssembly>
				<assemblyIdentity name="Microsoft.Web.Infrastructure" publicKeyToken="31bf3856ad364e35" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-2.0.0.0" newVersion="2.0.0.0" />
			</dependentAssembly>

			<!-- WebGrease (used by System.Web.Optimization) -->
			<dependentAssembly>
				<assemblyIdentity name="WebGrease" publicKeyToken="31bf3856ad364e35" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-1.6.5135.21930" newVersion="1.6.5135.21930" />
			</dependentAssembly>

			<!-- System.Memory (required by newer MySql.Data) -->
			<dependentAssembly>
				<assemblyIdentity name="System.Memory" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-4.0.5.0" newVersion="4.0.5.0" />
			</dependentAssembly>

			<!-- System.Runtime.CompilerServices.Unsafe -->
			<dependentAssembly>
				<assemblyIdentity name="System.Runtime.CompilerServices.Unsafe" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-6.0.3.0" newVersion="6.0.3.0" />
			</dependentAssembly>

			<!-- Microsoft.Extensions.* (used by some EF Core and logging libraries) -->
			<dependentAssembly>
				<assemblyIdentity name="Microsoft.Extensions.Primitives" publicKeyToken="adb9793829ddae60" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-3.1.1.0" newVersion="3.1.1.0" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="Microsoft.Extensions.Configuration.Abstractions" publicKeyToken="adb9793829ddae60" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-3.1.1.0" newVersion="3.1.1.0" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="Microsoft.Extensions.DependencyInjection.Abstractions" publicKeyToken="adb9793829ddae60" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-3.1.1.0" newVersion="3.1.1.0" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="Microsoft.Extensions.Logging.Abstractions" publicKeyToken="adb9793829ddae60" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-3.1.1.0" newVersion="3.1.1.0" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="Microsoft.Extensions.Options" publicKeyToken="adb9793829ddae60" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-3.1.1.0" newVersion="3.1.1.0" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="Microsoft.Extensions.DependencyInjection" publicKeyToken="adb9793829ddae60" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-3.1.1.0" newVersion="3.1.1.0" />
			</dependentAssembly>

			<!-- System.Threading.Tasks.Extensions -->
			<dependentAssembly>
				<assemblyIdentity name="System.Threading.Tasks.Extensions" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-4.2.0.1" newVersion="4.2.0.1" />
			</dependentAssembly>

			<!-- System.Diagnostics.DiagnosticSource -->
			<dependentAssembly>
				<assemblyIdentity name="System.Diagnostics.DiagnosticSource" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-7.0.0.2" newVersion="7.0.0.2" />
			</dependentAssembly>

			<!-- System.Buffers -->
			<dependentAssembly>
				<assemblyIdentity name="System.Buffers" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-4.0.5.0" newVersion="4.0.5.0" />
			</dependentAssembly>

			<!-- System.Numerics.Vectors -->
			<dependentAssembly>
				<assemblyIdentity name="System.Numerics.Vectors" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-4.1.6.0" newVersion="4.1.6.0" />
			</dependentAssembly>

			<!-- System.ComponentModel.Annotations -->
			<dependentAssembly>
				<assemblyIdentity name="System.ComponentModel.Annotations" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-4.2.1.0" newVersion="4.2.1.0" />
			</dependentAssembly>

			<!-- Microsoft.Bcl.AsyncInterfaces -->
			<dependentAssembly>
				<assemblyIdentity name="Microsoft.Bcl.AsyncInterfaces" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-5.0.0.0" newVersion="5.0.0.0" />
			</dependentAssembly>

			<!-- Microsoft.Extensions.Caching.Abstractions -->
			<dependentAssembly>
				<assemblyIdentity name="Microsoft.Extensions.Caching.Abstractions" publicKeyToken="adb9793829ddae60" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-3.1.1.0" newVersion="3.1.1.0" />
			</dependentAssembly>
		</assemblyBinding>
	</runtime>

	<!--
    ============================================================
    Entity Framework Configuration
    ============================================================
    Only one provider entry for MySql.Data.MySqlClient is kept,
    matching the installed version (9.7.0.0).
  -->
	<entityFramework>
		<providers>
			<provider invariantName="MySql.Data.MySqlClient"
					  type="MySql.Data.MySqlClient.MySqlProviderServices, MySql.Data.EntityFramework, Version=9.7.0.0, Culture=neutral, PublicKeyToken=c5687fc88969c44d" />
		</providers>
	</entityFramework>

	<!--
    ============================================================
    System.Web.Optimization (Bundling) - if used
    ============================================================
    This section is automatically handled by the NuGet package.
    No additional configuration needed here; the bundles are registered in code.
  -->
</configuration>